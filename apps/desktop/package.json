{
  "name": "@cadence/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/main.cjs",
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "dev": "pnpm build && electron .",
    "start": "electron .",
    "electron:ecs": "pnpm pkg set devDependencies.electron=github:castlabs/electron-releases#v44.10.0+wvcus && pnpm install",
    "dist": "pnpm build && electron-builder --config electron-builder.yml",
    "dist:dir": "pnpm build && electron-builder --dir --config electron-builder.yml"
  },
  "dependencies": {
    "@cadence/protocol": "workspace:*",
    "better-sqlite3": "13.0.3",
    "chokidar": "6.0.0",
    "music-metadata": "12.3.2",
    "youtubei.js": "^18.3.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "26.6.6",
    "electron": "45.1.0",
    "tsup": "9.0.0",
    "typescript": "^5.9.3",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "electron-builder": "^26.0.0"
  }
}