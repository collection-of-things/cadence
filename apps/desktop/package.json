{
  "name": "@cadence/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/main.cjs",
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "dev": "pnpm build && node scripts/launch.mjs",
    "start": "node scripts/launch.mjs",
    "electron:ecs": "echo \"ECS is the default electron dependency on this branch\"",
    "dist": "pnpm build && bash ../../scripts/package-assets.sh && electron-builder --config electron-builder.yml",
    "dist:dir": "pnpm build && bash ../../scripts/package-assets.sh && electron-builder --dir --config electron-builder.yml",
    "package:assets": "bash ../../scripts/package-assets.sh"
  },
  "dependencies": {
    "@cadence/protocol": "workspace:*",
    "better-sqlite3": "13.2.0",
    "bonjour-service": "1.4.4",
    "chokidar": "6.0.0",
    "music-metadata": "12.7.0",
    "qrcode": "1.5.4",
    "ws": "8.23.0",
    "youtubei.js": "^18.3.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "26.6.6",
    "@types/qrcode": "^1.5.6",
    "@types/ws": "8.18.2",
    "electron": "github:castlabs/electron-releases#v45.2.1+wvcus",
    "electron-builder": "^26.0.0",
    "fast-check": "4.10.2",
    "tla-ts": "0.0.10",
    "tsup": "9.0.0",
    "typescript": "^5.9.3",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  }
}
